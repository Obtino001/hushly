                  </svg>
                  <span class="g">Se anmeldelser</span>
                </a>
              </div>

            {%- when 'delivery_features' -%}
              <div class="deliv" {{ block.shopify_attributes }}>
                <div class="di"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h13v8H3zM16 10h3l2 3v2h-5z"></path><circle cx="7" cy="17" r="1.6"></circle><circle cx="18" cy="17" r="1.6"></circle></svg><span><b>Fri fragt</b> over 499 kr</span></div>
                <div class="di"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg><span><b>Hurtig levering</b> · 1-2 hverdage</span></div>
                <div class="di"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg><span><b>30 dages tilfredshedsgaranti</b> — eller pengene tilbage</span></div>
                <div class="di"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7v6h6M3 13a9 9 0 109-9"></path></svg><span><b>Nem retur</b> i 30 dage</span></div>
              </div>

            {%- when 'review_marquee' -%}
              <div class="mq" data-hp-mq="" {{ block.shopify_attributes }}>
                <div class="mqtrack" style="--mq-duration: 220s">
                  <!-- These would be dynamic from metaobjects or hardcoded as user requested -->
                  <div class="mqc"><img src="//hushly.dk/cdn/shop/files/white_2.png?v=1785161262&width=120" width="120" height="150" loading="lazy" class="pic">
                    <div><div class="ts" aria-hidden="true">★★★★★</div><p>Jeg købte en pude fra dem, og den var så behagelig...</p><div class="nm">— Verificeret køber</div></div>
                  </div>
                  <!-- Add more mqc items here if needed for repetition -->
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.show_sticky_cta -%}
          <div class="hpsticky is-visible" data-hp-sticky="">
            <div class="hpsticky__in">
              <img src="{{ product.featured_media | image_url: width: 120 }}" width="120" height="120" loading="lazy" class="hpsticky__img">
              <div class="hpsticky__txt">
                <span class="hpsticky__name">{{ product.title }}</span>
                <span class="hpsticky__price" data-hp-sticky-now="">{{ product.selected_or_first_available_variant.price | money }}</span>
              </div>
              <button type="submit" class="hpsticky__cta" data-hp-sticky-atc="" name="add">Tilføj til kurv</button>
            </div>
          </div>
        {%- endif -%}
      {% endform %}

      <!-- DETAILS -->
      <div class="details">
        {%- for block in section.blocks -%}
          {%- if block.type == 'details_block' -%}
            <div class="dblock" {{ block.shopify_attributes }}>
              <h3 class="dh">{{ block.settings.heading }}</h3>
              <div class="dp rte">{{ block.settings.content }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        
        <!-- Specifications Block -->
        <div class="dblock">
          <h3 class="dh">Specifikationer</h3>
          <dl class="spec">
            <div><dt>Sider</dt><dd>2-i-1 · is-silke + bambus</dd></div>
            <div><dt>Fyld</dt><dd>Justérbart fyld: lavendel-memory foam + fiber</dd></div>
            <div><dt>Betræk</dt><dd>Is-silke + åndbar bambus-strik</dd></div>
            <div><dt>Størrelse</dt><dd>50 × 70 cm</dd></div>
            <div><dt>Højde / fasthed</dt><dd>Justérbar — tilpas selv</dd></div>
            <div><dt>Vask</dt><dd>Aftageligt betræk, vask v. 40°</dd></div>
          </dl>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* Base styles */
  .hushly-pdp {
    --ink:#262A56; --iris:#6E5FBE; --lav:#A294D6; --lav-soft:#C7BCE8;
    --mist:#F3F0FB; --lilac:#ECE7F8; --bg:#FBFAFE; --surface:#FFFFFF;
    --muted:#5F5F70; --line:#E8E5F1; --gold:#E8B53A; --green:#2EA86A;
    --disp:"Outfit", system-ui, sans-serif; --sans:"Hanken Grotesk", system-ui, sans-serif;
    font-family: var(--sans); color: var(--ink); background: var(--bg);
  }
  .hushly-pdp *, .hushly-pdp *::before, .hushly-pdp *::after { box-sizing: border-box; }
  .hushly-pdp__product { max-width: var(--container-wide, 1500px); margin: 0 auto; padding: 32px var(--gutter, 20px) 12px; }
  .hushly-pdp__grid {
    display: grid;
    grid-template-columns: 1.04fr .96fr;
    grid-template-rows: auto 1fr;
    grid-template-areas: "gallery buybox" "details buybox";
    column-gap: 46px; row-gap: 30px; align-items: start;
  }
  .hushly-pdp .gallery { grid-area: gallery; min-width: 0; }
  .hushly-pdp .buybox { grid-area: buybox; min-width: 0; padding-top: 2px; }
  .hushly-pdp .details { grid-area: details; min-width: 0; }

  /* Gallery */
  .hushly-pdp .main { position: relative; aspect-ratio: 1/1; border-radius: 22px; overflow: hidden; border: 1px solid var(--line);
    background: radial-gradient(120% 120% at 32% 22%, #F6F3FC 0%, #EAE3F6 58%, #E1D8F1 100%);
    display: flex; align-items: center; justify-content: center; }
  .hushly-pdp .main-img { width: 100%; height: 100%; object-fit: cover; }
  .hushly-pdp .main--carousel { aspect-ratio: auto; border-radius: 0; overflow: visible; border: none; background: none; display: block; }
  .hushly-pdp .mainscroll { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .hushly-pdp .mainscroll::-webkit-scrollbar { display: none; }
  .hushly-pdp .mainslide { position: relative; flex: 0 0 86%; aspect-ratio: 1/1; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); background: radial-gradient(120% 120% at 32% 22%, #F6F3FC 0%, #EAE3F6 58%, #E1D8F1 100%); scroll-snap-align: start; }
  @media (min-width: 860px) {
    .hushly-pdp .buybox { max-width: 520px; }
    .hushly-pdp__grid { column-gap: 64px; }
    .hushly-pdp .main--carousel { aspect-ratio: 1/1; border-radius: 22px; overflow: hidden; border: 1px solid var(--line); background: radial-gradient(120% 120% at 32% 22%, #F6F3FC 0%, #EAE3F6 58%, #E1D8F1 100%); }
    .hushly-pdp .mainscroll { position: absolute; inset: 0; display: block; gap: 0; overflow: hidden; scroll-snap-type: none; transform: none; }
    .hushly-pdp .mainslide { position: absolute; inset: 0; flex: none; width: 100%; height: 100%; aspect-ratio: auto; border-radius: 0; border: none; background: none; opacity: 0; transition: opacity .3s ease; }
    .hushly-pdp .mainslide.is-active { opacity: 1; }
  }

  /* Slide USPS */
  .hushly-pdp .slide-usps { position: absolute; inset-block-start: 16px; inset-block-end: auto; inset-inline: 16px; z-index: 2; display: flex; flex-wrap: wrap; row-gap: 6px; pointer-events: none; }
  .hushly-pdp .su { display: inline-flex; align-items: center; gap: 5px; background: rgba(255,255,255,.96); color: var(--ink); font-family: var(--disp); font-weight: 600; font-size: 14px; padding: 8px 14px; border-radius: 999px; white-space: normal; flex: 0 0 auto; max-width: 100%; box-shadow: 0 4px 14px -6px rgba(38,42,86,.45); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .hushly-pdp .su svg { width: 16px; height: 16px; color: var(--iris); flex: none; }
  @media (max-width: 859px) {
    .hushly-pdp .slide-usps { inset-block-start: 10px; inset-inline: 10px; gap: 5px; }
    .hushly-pdp .su { font-size: 12px; padding: 6px 9px; gap: 5px; }
    .hushly-pdp .su svg { width: 14px; height: 14px; }
  }

  /* Buybox Typography */
  .hushly-pdp .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--sans); font-weight: 600; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--iris); margin-bottom: 10px; }
  .hushly-pdp .kicker .wm { display: none; }
  .hushly-pdp .kicker .wm .pd { color: var(--lav); }
  .hushly-pdp .title { font-family: var(--disp); font-weight: 600; font-size: 34px; letter-spacing: -.025em; line-height: 1.06; color: var(--ink); margin: 0; }
  .hushly-pdp .title .tm { display: none; }
  .hushly-pdp .hook { font-family: var(--disp); font-weight: 600; font-size: 20px; color: var(--ink); letter-spacing: -.01em; line-height: 1.25; margin-top: 8px; }
  .hushly-pdp .sub { color: var(--muted); font-size: 16px; line-height: 1.55; margin-top: 8px; }
  
  /* Badges */
  .hushly-pdp .sides { display: flex; align-items: center; gap: 8px; margin-top: 16px; flex-wrap: wrap !important; }
  .hushly-pdp .sbadge { display: inline-flex; align-items: center; gap: 7px; font-family: var(--disp); font-weight: 600; font-size: 14px; padding: 6px 12px; border-radius: 999px; border: 1.4px solid; line-height: 1; white-space: nowrap !important; flex: 0 0 auto !important; }
  .hushly-pdp .sbadge svg { width: 16px; height: 16px; flex: none; }
  .hushly-pdp .sbadge--cool { color: #2f6db0; border-color: #c4e2f4; background: #eef7fd; }
  .hushly-pdp .sbadge--lav { color: var(--iris); border-color: var(--lilac); background: var(--mist); }
  .hushly-pdp .sides-mid { display: none; white-space: nowrap !important; flex: 0 0 auto !important; }
  @media (max-width: 859px) { .hushly-pdp .sides { gap: 6px; } .hushly-pdp .sbadge { font-size: 11.5px; padding: 6px 10px; gap: 5px; } .hushly-pdp .sbadge svg { width: 13px; height: 13px; } }

  /* Price */
  .hushly-pdp .price { display: flex; align-items: baseline; gap: 12px; margin-top: 22px; flex-wrap: wrap; }
  .hushly-pdp .price .now { font-family: var(--disp); font-weight: 600; font-size: 30px; letter-spacing: -.015em; }
  .hushly-pdp .price .was { font-size: 16px; color: var(--muted); text-decoration: line-through; }
  .hushly-pdp .price .save { font-size: 12px; font-weight: 600; color: #fff; background: var(--iris); padding: 4px 10px; border-radius: 999px; align-self: center; }

  /* Buttons */
  .hushly-pdp .cta, .hushly-pdp .hpsticky__cta {
    background: linear-gradient(105deg, #A78DF7 0%, #8571E4 26%, #5F51B4 58%, #2C2E5C 100%) !important;
    border: none !important; color: #fff !important; width: 100%; border-radius: 14px;
    font-family: var(--disp); font-weight: 600; font-size: 16px; padding: 19px; margin-top: 24px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px;
    box-shadow: 0 12px 26px -10px rgba(110,95,190,.62) !important;
    transition: filter .2s ease, box-shadow .2s ease, transform .18s ease !important;
  }
  .hushly-pdp .cta:hover, .hushly-pdp .hpsticky__cta:hover {
    filter: brightness(1.08) saturate(1.06) !important; box-shadow: 0 14px 30px -8px rgba(110,95,190,.75) !important; transform: translateY(-1px) !important;
  }
  .hushly-pdp .cta svg { width: 18px; height: 18px; color: #fff !important; transition: .18s; }
  .hushly-pdp .cta:hover svg { transform: translateX(3px); }

  /* Thumbnails, USPS, Bundles CSS omitted for brevity but they are standard based on provided HTML */
  /* Re-implementing exactly as provided */
  .hushly-pdp .usps { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 28px; margin-top: 20px; }
  .hushly-pdp .usp { display: flex; align-items: flex-start; gap: 10px; font-size: 16px; font-weight: 400; line-height: 1.35; }
  .hushly-pdp .usp .i { width: var(--usp-box, 38px); height: var(--usp-box, 38px); border-radius: calc(var(--usp-box, 38px) * .26); flex: 0 0 auto; }
  .hushly-pdp .usp .i .uspimg { width: 100%; height: 100%; object-fit: contain; display: block; }
  
  .hushly-pdp .bundles { display: grid; gap: 10px; margin-top: 20px; }
  .hushly-pdp .bundle { position: relative; display: flex; align-items: center; gap: 13px; border: 1px solid var(--line); border-radius: 14px; padding: 13px 15px; cursor: pointer; background: var(--surface); transition: .15s; margin: 0; }
  .hushly-pdp .bundle.sel { border-color: var(--iris); background: var(--mist); }
  .hushly-pdp .radio { flex: 0 0 auto; width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--lav-soft); position: relative; }
  .hushly-pdp .bundle.sel .radio { border-color: var(--iris); }
  .hushly-pdp .bundle.sel .radio::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--iris); }
  .hushly-pdp .bthumb { flex: 0 0 auto; width: 60px; height: 60px; border-radius: 12px; background: #fff; border: 1px solid var(--line); object-fit: cover; }
  .hushly-pdp .bmid { flex: 1; min-width: 0; }
  .hushly-pdp .bmid .bt { font-family: var(--disp); font-weight: 600; font-size: 16px; }
  .hushly-pdp .bmid .bd { font-size: 12px; color: var(--muted); margin-top: 1px; }
  .hushly-pdp .bright { text-align: right; flex: 0 0 auto; }
  .hushly-pdp .bright .bp { font-family: var(--disp); font-weight: 600; font-size: 16px; }
  .hushly-pdp .bright .bw { font-size: 12px; color: var(--muted); text-decoration: line-through; }
  .hushly-pdp .tag { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; vertical-align: middle; margin-left: 8px; background: var(--ink); color: #fff; }
  .hushly-pdp .tag.val { background: var(--lilac); color: var(--iris); }

  .hushly-pdp .shipmsg { display: flex; align-items: center; gap: 9px; margin: 14px 0 0; padding: 10px 14px; border-radius: 12px; background: var(--mist); border: 1px solid var(--line); font-size: 13px; line-height: 1.4; color: var(--ink); }
  .hushly-pdp .shipmsg__dot { width:9px; height:9px; border-radius:50%; background:var(--green); flex:0 0 auto; box-shadow:0 0 0 3px color-mix(in srgb, var(--green) 18%, transparent); }
  .hushly-pdp .offerurg { display: flex; align-items: center; gap: 11px; margin: 16px 0 0; padding: 11px 13px; border: 1px solid var(--lilac); border-radius: 14px; background: var(--mist); color: var(--ink); }
  
  .hushly-pdp .trustrow { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-top: 16px; }
  .hushly-pdp .pays { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .hushly-pdp .pays svg { height: 24px; width: auto; border-radius: 5px; }
  
  .hushly-pdp .deliv { margin-top: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--mist); padding: 15px 16px; display: grid; gap: 12px; }
  .hushly-pdp .di { display: flex; align-items: center; gap: 11px; font-size: 14px; line-height: 1.35; color: var(--muted); }
  .hushly-pdp .di svg { width: 18px; height: 18px; color: var(--iris); stroke-width: 1.6; flex: 0 0 auto; }

  /* Details Accordion */
  .hushly-pdp .details { margin-top: 40px; }
  .hushly-pdp .dblock { padding: 20px 0; border-top: 1px solid var(--line); }
  .hushly-pdp .dh { font-family: var(--disp); font-weight: 600; font-size: 17px; margin-bottom: 11px; }
  .hushly-pdp .dp { font-size: 14px; color: var(--muted); line-height: 1.65; }
  .hushly-pdp .spec { display: grid; }
  .hushly-pdp .spec > div { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .hushly-pdp .spec dt { color: var(--muted); }
  .hushly-pdp .spec dd { font-weight: 600; text-align: right; margin: 0; }
  
  @media (max-width: 860px) {
    .hushly-pdp__grid { grid-template-columns: 1fr; grid-template-rows: none; grid-template-areas: "gallery" "buybox" "details"; row-gap: 24px; }
    .hushly-pdp .title { font-size: 32px; }
    .hushly-pdp .hook { font-size: 18px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Gallery Thumbnails
    const thumbs = document.querySelectorAll('[data-hp-thumb]');
    const slides = document.querySelectorAll('[data-hp-slide]');
    thumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        thumbs.forEach(t => t.classList.remove('active'));
        slides.forEach(s => s.classList.remove('is-active'));
        thumb.classList.add('active');
        slides[thumb.dataset.index].classList.add('is-active');
      });
    });

    // Bundle Radio Logic
    const bundles = document.querySelectorAll('.bundle');
    const addonSection = document.querySelector('[data-hp-addon-colors]');
    bundles.forEach(bundle => {
      bundle.addEventListener('click', () => {
        bundles.forEach(b => b.classList.remove('sel'));
        bundle.classList.add('sel');
        bundle.querySelector('input').checked = true;
        
        if(bundle.dataset.addon === 'true') {
          addonSection.hidden = false;
        } else {
          addonSection.hidden = true;
        }
      });
    });
  });
</script>

