<div class="hushly-pdp" data-hushly-product="" data-hp-ready="true">
  <div class="hushly-pdp__product">
    <div class="hushly-pdp__grid">
      
      <!-- GALLERY -->
      <div class="gallery" data-hp-gallery="">
        <div class="main main--carousel">
          <div class="mainscroll" data-hp-mainscroll="">
            {%- for media in product.media -%}
              <div class="mainslide {% if forloop.first %}is-active{% endif %}" data-hp-slide="">
                {{ media | image_url: width: 1200 | image_tag: loading: 'eager', class: 'main-img', sizes: '(min-width: 1580px) 715px, (min-width: 860px) 46vw, 79vw' }}
                {%- if section.settings.show_image_usps -%}
                  <div class="slide-usps">
                    {%- if forloop.index == 1 -%}
                      <span class="su">{% render 'icon', icon: 'leaf' %} Et strejf lavendel</span>
                      <span class="su">{% render 'icon', icon: 'moon' %} Ro før sengetid</span>
                    {%- elsif forloop.index == 2 -%}
                      <span class="su">{% render 'icon', icon: 'snow' %} Kølende is-silke</span>
                      <span class="su">{% render 'icon', icon: 'check' %} Sval ved berøring</span>
                    {%- elsif forloop.index == 3 -%}
                      <span class="su">{% render 'icon', icon: 'shield' %} Ergonomisk memory foam</span>
                      <span class="su">{% render 'icon', icon: 'check' %} Trykaflastende støtte</span>
                    {%- elsif forloop.index == 4 -%}
                      <span class="su">{% render 'icon', icon: 'heart' %} Premium dansk design</span>
                      <span class="su">{% render 'icon', icon: 'moon' %} 30 dages tilfredshedsgaranti</span>
                    {%- elsif forloop.index == 5 -%}
                      <span class="su">{% render 'icon', icon: 'snow' %} Sov køligt hele natten</span>
                      <span class="su">{% render 'icon', icon: 'check' %} Ingen klamme zoner</span>
                    {%- elsif forloop.index == 6 -%}
                      <span class="su">{% render 'icon', icon: 'heart' %} Blød & luksuriøs</span>
                      <span class="su">{% render 'icon', icon: 'shield' %} Holder formen</span>
                    {%- elsif forloop.index == 7 -%}
                      <span class="su">{% render 'icon', icon: 'shield' %} Vågn uden nakkesmerter</span>
                      <span class="su">{% render 'icon', icon: 'moon' %} Alle sovestillinger</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
            
            {%- if product.media.size == 0 -%}
               <div class="mainslide is-active" data-hp-slide="">
                 {{ 'product-1' | placeholder_svg_tag: 'main-img' }}
               </div>
            {%- endif -%}
          </div>
          
          <div class="mainaddon" data-hp-addon-img="" hidden="">
            <div class="mainaddon__slide is-active" data-hp-addon-slide="" data-variant-id="58163201114460">
              <img src="//hushly.dk/cdn/shop/files/1xbetraek_3dfadadc-7e30-47aa-90f8-dbaf84385606.png?v=1782810060&width=1200" alt="Hushly Kølende Betræk" width="1200" height="1200" loading="lazy" class="main-img">
            </div>
            <div class="mainaddon__slide" data-hp-addon-slide="" data-variant-id="58144876298588">
              <img src="//hushly.dk/cdn/shop/files/30._jun._2026_11.00.53.png?v=1782810052&width=1200" alt="Hushly Kølende Betræk" width="1200" height="1200" loading="lazy" class="main-img">
            </div>
          </div>
        </div>

        <div class="thumbs">
          {%- for media in product.media -%}
            <button type="button" class="thumb {% if forloop.first %}active{% endif %}" data-hp-thumb="" data-index="{{ forloop.index0 }}" aria-label="Vis billede {{ forloop.index }}">
              {{ media | image_url: width: 200 | image_tag: loading: 'lazy', class: 'thumb-img', sizes: '60px' }}
            </button>
          {%- endfor -%}
        </div>
      </div>
      
      <!-- BUY BOX -->
      {%- assign product_form_id = 'product-form-' | append: section.id -%}
      
      {% form 'product', product, class: 'buybox', data-hp-form: '', id: product_form_id, novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-hp-variant="">
        <input type="hidden" name="quantity" value="1" data-hp-qty="">
        <input type="hidden" data-hp-addon="" value="58163201114460">
        <input type="hidden" data-hp-addon2="" value="58163201114460">

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            
            {%- when 'kicker' -%}
              <div class="kicker" {{ block.shopify_attributes }}>
                <span class="wm">{{ shop.name }}<span class="pd">.</span></span>
                <span class="kd"></span>{{ block.settings.text }}
              </div>

            {%- when 'title' -%}
              <h1 class="title" {{ block.shopify_attributes }}>{{ product.title | escape }}<span class="tm">™</span></h1>

            {%- when 'hook' -%}
              <p class="hook" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

            {%- when 'subtext' -%}
              <p class="sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

            {%- when 'badges' -%}
              <div class="sides" aria-label="To sider i én pude" {{ block.shopify_attributes }}>
                <span class="sbadge sbadge--cool">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 2v20M5 7l14 10M19 7 5 17M2.5 12h19"></path></svg>
                  Kølende is-silke
                </span>
                <span class="sides-mid">2-i-1 vendbar</span>
                <span class="sbadge sbadge--lav">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M5 21c8.5 0 14-5.5 14-14 0 0-3.2 1-6.5 1C7 8 4 11 4 16.5c0 1.6 0 3.2 1 4.5Z"></path><path d="M5 21c1-5.5 4.2-8.7 8.5-10.5"></path></svg>
                  Lavendelduft
                </span>
              </div>

            {%- when 'price' -%}
              <div class="price" {{ block.shopify_attributes }}>
                <span class="now" data-hp-now="">{{ product.selected_or_first_available_variant.price | money }}</span>
                {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                  <span class="was" data-hp-was="">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
                  <span class="save" data-hp-save="">Spar {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}</span>
                {%- endif -%}
              </div>

            {%- when 'usps' -%}
              <div class="usps" style="--usp-icon: 34px; --usp-box: 38px" {{ block.shopify_attributes }}>
                <div class="usp"><span class="i"><img src="//hushly.dk/cdn/shop/files/ChatGPT_Image_27._jul._2026_20.19.34_4.png?v=1785180670&width=144" width="144" height="83" loading="lazy" class="uspimg"></span>Sov køligt hele natten</div>
                <div class="usp"><span class="i"><img src="//hushly.dk/cdn/shop/files/ChatGPT_Image_27._jul._2026_20.19.33_2.png?v=1785178345&width=144" width="144" height="99" loading="lazy" class="uspimg"></span>Vælg din side hver nat</div>
                <div class="usp"><span class="i"><img src="//hushly.dk/cdn/shop/files/ChatGPT_Image_27._jul._2026_20.19.34_3.png?v=1785179494&width=144" width="144" height="93" loading="lazy" class="uspimg"></span>Tilpas højde & fasthed</div>
                <div class="usp"><span class="i"><img src="//hushly.dk/cdn/shop/files/ChatGPT_Image_27._jul._2026_20.19.34_4.png?v=1785180670&width=144" width="144" height="83" loading="lazy" class="uspimg"></span>Til alle sovestillinger</div>
              </div>

            {%- when 'variant_picker' -%}
              <div class="bundles" role="radiogroup" aria-label="Vælg pakke" {{ block.shopify_attributes }}>
                <label class="bundle sel" data-hp-bundle="" data-qty="1" data-addon="false" data-addon-qty="1" data-now="499 kr" data-was="599 kr" data-save="Spar 100 kr">
                  <input type="radio" name="hp-bundle" class="hushly-pdp__br" value="1" checked="">
                  <span class="radio" aria-hidden="true"></span>
                  <img src="//hushly.dk/cdn/shop/files/0020.jpg?v=1782474615&width=160" width="160" height="160" loading="lazy" class="bthumb bthumb--img">
                  <div class="bmid">
                    <div class="bt">1× PerfectPillow</div>
                    <div class="bd">Prøv den i 30 dage</div>
                  </div>
                  <div class="bright">
                    <div class="bw">599 kr</div><div class="bp">499 kr</div>
                  </div>
                </label>
                <label class="bundle" data-hp-bundle="" data-qty="1" data-addon="true" data-addon-qty="1" data-now="574 kr" data-was="698 kr" data-save="Spar 124 kr">
                  <input type="radio" name="hp-bundle" class="hushly-pdp__br" value="2">
                  <span class="radio" aria-hidden="true"></span>
                  <img src="//hushly.dk/cdn/shop/files/1xbetraek.png?v=1782554288&width=160" width="160" height="160" loading="lazy" class="bthumb bthumb--img">
                  <div class="bmid">
                    <div class="bt">PerfectPillow + Betræk</div>
                    <div class="bd">Betræk kun 75 kr (normalt 99)</div>
                  </div>
                  <div class="bright">
                    <div class="bw">698 kr</div><div class="bp">574 kr</div>
                  </div>
                </label>
                <label class="bundle" data-hp-bundle="" data-qty="2" data-addon="true" data-addon-qty="2" data-now="998 kr" data-was="1.396 kr" data-save="Spar 398 kr">
                  <input type="radio" name="hp-bundle" class="hushly-pdp__br" value="3">
                  <span class="radio" aria-hidden="true"></span>
                  <img src="//hushly.dk/cdn/shop/files/2xbetraekpluspuder.png?v=1782554248&width=160" width="160" height="160" loading="lazy" class="bthumb bthumb--img">
                  <div class="bmid">
                    <div class="bt">2× PerfectPillow + 2× Betræk <span class="tag val">Bedste værdi</span></div>
                    <div class="bd">Begge betræk gratis</div>
                  </div>
                  <div class="bright">
                    <div class="bw">1.396 kr</div><div class="bp">998 kr</div>
                  </div>
                </label>
              </div>

              <div class="addoncolor" data-hp-addon-colors="" hidden="">
                <div class="addoncolor__slot">
                  <span class="addoncolor__lab" data-hp-addon-lab="" data-one="Vælg farve på betræk" data-two="Farve på betræk nr. 1">Vælg farve på betræk</span>
                  <div class="addoncolor__opts" role="radiogroup" aria-label="Betræk-farve">
                    <label class="addoncolor__opt sel">
                      <input type="radio" name="hp-addon-color" value="58163201114460" data-hp-addon-color="" checked="">
                      <span class="addoncolor__sw" style="--sw: #9AA0B4" aria-hidden="true"></span>
                      <span class="addoncolor__nm">Grå</span>
                    </label>
                    <label class="addoncolor__opt">
                      <input type="radio" name="hp-addon-color" value="58144876298588" data-hp-addon-color="">
                      <span class="addoncolor__sw" style="--sw: #FFFFFF" aria-hidden="true"></span>
                      <span class="addoncolor__nm">Hvid</span>
                    </label>
                  </div>
                </div>
                <div class="addoncolor__slot addoncolor__slot2" data-hp-addon-colors2="" hidden="">
                  <span class="addoncolor__lab">Farve på betræk nr. 2</span>
                  <div class="addoncolor__opts" role="radiogroup" aria-label="Farve på betræk nr. 2">
                    <label class="addoncolor__opt sel">
                      <input type="radio" name="hp-addon-color-2" value="58163201114460" data-hp-addon-color2="" checked="">
                      <span class="addoncolor__sw" style="--sw: #9AA0B4" aria-hidden="true"></span>
                      <span class="addoncolor__nm">Grå</span>
                    </label>
                    <label class="addoncolor__opt">
                      <input type="radio" name="hp-addon-color-2" value="58144876298588" data-hp-addon-color2="">
                      <span class="addoncolor__sw" style="--sw: #FFFFFF" aria-hidden="true"></span>
                      <span class="addoncolor__nm">Hvid</span>
                    </label>
                  </div>
                </div>
              </div>

            {%- when 'campaign' -%}
              <div class="offerurg" data-hp-offer="" data-bundles="" {{ block.shopify_attributes }}>
                <span class="offerurg__ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="8" width="18" height="13" rx="2"></rect><path d="M3 12h18M12 8v13"></path><path d="M12 8S9.5 3.5 7.2 4.4C5.6 5 5.6 7.2 7.2 7.8 8.6 8.3 12 8 12 8ZM12 8s2.5-4.5 4.8-3.6c1.6.6 1.6 2.8 0 3.4C15.4 8.3 12 8 12 8Z"></path></svg>
                </span>
                <span class="offerurg__txt">
                  <b class="offerurg__head">{{ block.settings.heading }}</b>
                  <span class="offerurg__sub">{{ block.settings.subtext }}</span>
                </span>
              </div>

            {%- when 'shipping_message' -%}
              <div class="shipmsg" data-hp-ship="" data-cutoff="{{ block.settings.cutoff }}" data-today="{{ block.settings.today_text }}" data-default="{{ block.settings.default_text }}" {{ block.shopify_attributes }}>
                <span class="shipmsg__dot" aria-hidden="true"></span>
                <span class="shipmsg__body">
                  <b class="shipmsg__stock">På lager</b><span class="shipmsg__sep"> · </span>
                  <span data-hp-ship-text="">{{ block.settings.default_text }} <span class="ship-sep">·</span> <span class="ship-today">bestil inden for <strong>02:55:17</strong>, så sender vi i dag</span></span>
                </span>
              </div>

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                <button type="submit" class="cta" data-hp-atc="" name="add">
                  {{ block.settings.button_text }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </button>
                <p class="hushly-pdp__err" data-hp-err="" role="alert" hidden="">Noget gik galt. Prøv igen.</p>
                
                {%- if block.settings.show_secure_text -%}
                  <div class="ctasub">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 018 0v3"></path></svg>
                    Sikker & krypteret betaling
                  </div>
                {%- endif -%}
              </div>

            {%- when 'trust_row' -%}
              <div class="trustrow" {{ block.shopify_attributes }}>
                <div class="pays">
                  {{ 'dankort' | payment_type_svg_tag }}
                  {{ 'visa' | payment_type_svg_tag }}
                  {{ 'master' | payment_type_svg_tag }}
                  {{ 'apple_pay' | payment_type_svg_tag }}
                  {{ 'mobilepay' | payment_type_svg_tag }}
                </div>
                <a class="tp" href="https://dk.trustpilot.com/review/hushly.dk" target="_blank" rel="noopener" aria-label="Se vores anmeldelser på Trustpilot">
                  <svg class="tp-logo tp__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 140 34" width="112" height="27" role="img" aria-label="Trustpilot" focusable="false">
