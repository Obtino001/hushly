  .hushly-pdp .vid.is-playing .vplay { display: none; }
  .hushly-pdp .vid .vlabel { position: absolute; left: 12px; bottom: 11px; font-size: 12px; font-weight: 600; color: #fff; text-shadow: 0 1px 5px rgba(0,0,0,.45); pointer-events: none; }

  /* details */
  .hushly-pdp .dblock { padding: 20px 0; border-top: 1px solid var(--line); }
  .hushly-pdp .dblock:first-child { padding-top: 6px; border-top: none; }
  .hushly-pdp .dp { font-size: 14px; color: var(--muted); line-height: 1.65; }
  .hushly-pdp .dp p + p { margin-top: 12px; }
  .hushly-pdp .spec { display: grid; }
  .hushly-pdp .spec > div { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .hushly-pdp .spec > div:last-child { border-bottom: none; }
  .hushly-pdp .spec dt { color: var(--muted); }
  .hushly-pdp .spec dd { font-weight: 600; text-align: right; }

  @media (max-width: 860px) {
    .hushly-pdp__grid { grid-template-columns: 1fr; grid-template-rows: none; grid-template-areas: "gallery" "buybox" "details"; row-gap: 24px; }
    .hushly-pdp .title { font-size: 32px; }
    .hushly-pdp .hook { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hushly-pdp .mqtrack { animation: none; }
    .hushly-pdp .cta, .hushly-pdp .cta svg, .hushly-pdp .thumb, .hushly-pdp .bundle { transition: none; }
  }
</style>


</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Gallery Thumbnails
    const thumbs = document.querySelectorAll('[data-hp-thumb]');
    const slides = document.querySelectorAll('[data-hp-slide]');
    thumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        thumbs.forEach(t => t.classList.remove('active'));
        slides.forEach(s => s.classList.remove('is-active'));
        thumb.classList.add('active');
        slides[thumb.dataset.index].classList.add('is-active');
      });
    });

    // Bundle Radio Logic
    const bundles = document.querySelectorAll('.bundle');
    const addonSection = document.querySelector('[data-hp-addon-colors]');
    bundles.forEach(bundle => {
      bundle.addEventListener('click', () => {
        bundles.forEach(b => b.classList.remove('sel'));
        bundle.classList.add('sel');
        bundle.querySelector('input').checked = true;
        
        if(bundle.dataset.addon === 'true') {
          addonSection.hidden = false;
        } else {
          addonSection.hidden = true;
        }
      });
    });
  });
</script>

