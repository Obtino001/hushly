  /* testimonial marquee */
  .hushly-pdp .mq { overflow: hidden; margin-top: 18px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
  .hushly-pdp .mqtrack { display: flex; gap: 14px; width: max-content; animation: hushly-pdp-mq var(--mq-duration, 40s) linear infinite; }
