<aside class="hushly-announcement hushly-announcement--{{ section.settings.color_scheme }}" data-announcement="" data-rotate="{{ section.settings.rotation_speed }}" aria-label="Tilbud og leveringsinfo">
  <div class="container container--wide hushly-announcement__inner">
    <div class="hushly-announcement__aside hushly-announcement__aside--left">
      {%- if section.settings.left_text != blank -%}
        {%- if section.settings.left_link != blank -%}
          <a href="{{ section.settings.left_link }}" class="hushly-announcement__link">
            <span>{{ section.settings.left_text }}</span>
          </a>
        {%- else -%}
          <span class="hushly-announcement__link hushly-announcement__link--static">
            <span>{{ section.settings.left_text }}</span>
          </span>
        {%- endif -%}
      {%- endif -%}
    </div>
    
    <div class="hushly-announcement__messages">
      <div class="hushly-announcement__track">
        {%- for block in section.blocks -%}
          <p class="hushly-announcement__msg {% if forloop.first %}is-active{% endif %}" data-announcement-item="" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </p>
        {%- endfor -%}
        
        <!-- Duplicates for mobile marquee -->
        {%- for block in section.blocks -%}
          <p class="hushly-announcement__msg hushly-announcement__msg--dup" aria-hidden="true">
            {{ block.settings.text }}
          </p>
        {%- endfor -%}
      </div>
    </div>
    
    <div class="hushly-announcement__aside hushly-announcement__aside--right">
      {%- if section.settings.right_text != blank -%}
        <span class="hushly-announcement__note">{{ section.settings.right_text }}</span>
      {%- endif -%}
    </div>
  </div>
</aside>

<style>
  .hushly-announcement {
    --ann-bg: var(--ink);
    background: var(--ann-bg);
    color: var(--on-dark);
    font-size: var(--fs-sm);
  }
  .hushly-announcement--ink { --ann-bg: var(--ink); }
  .hushly-announcement--charcoal { --ann-bg: var(--charcoal); }
  .hushly-announcement--iris { --ann-bg: var(--accent); }

  .hushly-announcement__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    min-height: 2.5rem;
    padding-block: var(--space-2);
  }

  .hushly-announcement__aside {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .hushly-announcement__aside--right { justify-content: flex-end; }

  .hushly-announcement__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--on-dark);
    white-space: nowrap;
    text-decoration: none;
  }
  a.hushly-announcement__link:hover { color: var(--on-dark); text-decoration: underline; text-underline-offset: .2em; }

  .hushly-announcement__note {
    color: var(--on-dark);
    white-space: nowrap;
    letter-spacing: .02em;
  }

  .hushly-announcement__messages {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hushly-announcement__track { display: grid; justify-items: center; }
  .hushly-announcement__msg {
    grid-area: 1 / 1;
    margin: 0;
    color: var(--on-dark);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease);
  }
  .hushly-announcement__msg.is-active { opacity: 1; pointer-events: auto; }
  .hushly-announcement__msg--dup { display: none; }

  @media (max-width: 767px) {
    .hushly-announcement__aside { display: none; }
    .hushly-announcement__inner { grid-template-columns: 1fr; gap: 0; }
    .hushly-announcement__messages { overflow: hidden; }
    .hushly-announcement__track {
      display: flex;
      width: max-content;
      animation: hushly-ann-marquee 18s linear infinite;
    }
    .hushly-announcement__msg {
      grid-area: auto;
      opacity: 1;
      pointer-events: auto;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
    }
    .hushly-announcement__msg::after {
      content: "·";
      margin-inline: var(--space-4);
      opacity: .5;
    }
    .hushly-announcement__msg--dup { display: inline-flex; }
  }

  @keyframes hushly-ann-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .hushly-announcement__track { animation: none; }
    .hushly-announcement__messages { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .hushly-announcement__messages::-webkit-scrollbar { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hushly-announcement__msg { transition: none; }
    .hushly-announcement__track { animation: none; }
  }
</style>

{% schema %}
{
  "name": "Hushly Announcement Bar",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "charcoal", "label": "Charcoal" },
        { "value": "iris", "label": "Iris" }
      ],
      "default": "ink"
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Desktop Rotation Speed",
      "default": 5
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left Note Text",
      "default": "Brug for hjælp?"
    },
    {
      "type": "url",
      "id": "left_link",
      "label": "Left Note Link (Optional)"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right Note Text",
      "default": "Dansk design"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Fri fragt over 499 kr"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hushly Announcement Bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Fri fragt over 499 kr" } },
        { "type": "message", "settings": { "text": "30 dages tilfredshedsgaranti" } },
        { "type": "message", "settings": { "text": "Sov blødere — eller pengene tilbage" } }
      ]
    }
  ]
}
{% endschema %}
