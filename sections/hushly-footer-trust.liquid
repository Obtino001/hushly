<div class="hushly-trust scheme scheme--{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <ul class="hushly-trust__list" role="list">
        {%- for block in section.blocks -%}
          <li class="hushly-trust__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="hushly-trust__icon">
                {% render 'icon', icon: block.settings.icon %}
              </span>
            {%- endif -%}
            <span class="hushly-trust__body">
              <span class="hushly-trust__title">{{ block.settings.title }}</span>
              <span class="hushly-trust__text">{{ block.settings.text }}</span>
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<style>
  .hushly-trust { background: var(--sc-bg); color: var(--sc-text); }
  .hushly-trust .container { padding-block: var(--space-12); }
  .hushly-trust__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-6); list-style: none; margin: 0; padding: 0; }
  .hushly-trust__item { display: flex; align-items: flex-start; gap: var(--space-3); }
  .hushly-trust__icon {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: var(--space-12, 48px); height: var(--space-12, 48px);
    border-radius: var(--radius-pill);
    background: var(--sc-chip, var(--lavender-mist));
    color: var(--sc-accent, var(--accent));
  }
  .hushly-trust__icon svg { width: 20px; height: 20px; }
  .hushly-trust__body { display: flex; flex-direction: column; gap: var(--nudge, 2px); }
  .hushly-trust__title { font-weight: 600; color: var(--sc-text, var(--ink)); }
  .hushly-trust__text { font-size: var(--fs-sm); color: var(--sc-muted, var(--muted)); }

  @media (min-width: 720px) {
    .hushly-trust__list { grid-template-columns: repeat(4, 1fr); }
  }
</style>

{% schema %}
{
  "name": "Hushly Footer Trust",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "mist", "label": "Mist" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "lilac", "label": "Lilac" },
        { "value": "surface", "label": "Surface" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "mist"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Snippet Name)",
          "default": "moon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30 dages tilfredshedsgaranti"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Eller pengene tilbage."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hushly Footer Trust",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "moon", "title": "30 dages tilfredshedsgaranti", "text": "Eller pengene tilbage." } },
        { "type": "trust_item", "settings": { "icon": "truck", "title": "Fri fragt over 499 kr", "text": "1-2 hverdages levering." } },
        { "type": "trust_item", "settings": { "icon": "shield", "title": "Nem retur", "text": "I 30 dage." } },
        { "type": "trust_item", "settings": { "icon": "heart", "title": "Dansk design & support", "text": "Svar inden for 24 timer." } }
      ]
    }
  ]
}
{% endschema %}
