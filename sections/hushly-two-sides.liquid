<section class="hushly-twosides scheme scheme--{{ section.settings.color_scheme }}">
  <div class="container container--wide hushly-twosides__inner">
    <div class="hushly-twosides__head" data-reveal="">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hushly-twosides__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hushly-twosides__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="hushly-twosides__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <ul class="hushly-twosides__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="hushly-twosides__card" data-reveal="" style="--reveal-delay: calc(var(--reveal-step) * {{ forloop.index0 }})" {{ block.shopify_attributes }}>
            <div class="hushly-twosides__media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" 
                     alt="{{ block.settings.title | escape }}" 
                     srcset="{{ block.settings.image | image_url: width: 340 }} 340w, {{ block.settings.image | image_url: width: 540 }} 540w, {{ block.settings.image | image_url: width: 680 }} 680w, {{ block.settings.image | image_url: width: 900 }} 900w" 
                     width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" 
                     loading="lazy" class="hushly-twosides__img" 
                     sizes="(min-width: 1580px) 734px, (min-width: 768px) 45vw, calc(100vw - 2rem)">
              {%- else -%}
                <div class="hushly-twosides__placeholder"></div>
              {%- endif -%}
            </div>
            
            <div class="hushly-twosides__body">
              {%- if block.settings.icon != 'none' -%}
                <span class="hushly-twosides__icon">
                  {% render 'icon', icon: block.settings.icon %}
                </span>
              {%- endif -%}
              
              <h3 class="hushly-twosides__title">{{ block.settings.title }}</h3>
              <p class="hushly-twosides__text">{{ block.settings.text }}</p>
              
              {%- if block.settings.usp_1_text != blank or block.settings.usp_2_text != blank or block.settings.usp_3_text != blank -%}
                <ul class="hushly-twosides__usps" role="list">
                  {%- if block.settings.usp_1_text != blank -%}
                    <li>
                      <span class="hushly-twosides__usp-icon">
                        {% render 'icon', icon: block.settings.usp_1_icon %}
                      </span>
                      <span>{{ block.settings.usp_1_text }}</span>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.usp_2_text != blank -%}
                    <li>
                      <span class="hushly-twosides__usp-icon">
                        {% render 'icon', icon: block.settings.usp_2_icon %}
                      </span>
                      <span>{{ block.settings.usp_2_text }}</span>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.usp_3_text != blank -%}
                    <li>
                      <span class="hushly-twosides__usp-icon">
                        {% render 'icon', icon: block.settings.usp_3_icon %}
                      </span>
                      <span>{{ block.settings.usp_3_text }}</span>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  .hushly-twosides__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--section-y);
  }
  .hushly-twosides__head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-3); max-width: var(--maxw-lead); }
  .hushly-twosides__eyebrow { color: var(--sc-accent, var(--accent)); margin: 0; }
  .hushly-twosides__heading { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); color: var(--sc-text, var(--ink)); margin: 0; }
  .hushly-twosides__intro { font-size: var(--fs-lead); line-height: var(--lh-body); color: var(--sc-muted, var(--muted)); margin: 0; }

  /* Mobile: stacked cards. Desktop: 2-col grid. */
  .hushly-twosides__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    width: 100%;
    margin: 0; padding: 0; list-style: none;
  }
  .hushly-twosides__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--sc-soft, var(--surface));
    border: 1px solid var(--sc-border, var(--line));
    border-radius: var(--radius-lg);
  }
  .hushly-twosides__media { aspect-ratio: 4 / 3; background: var(--sc-chip, var(--lilac)); }
  .hushly-twosides__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hushly-twosides__placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--lilac), var(--accent-soft)); }

  .hushly-twosides__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); padding: var(--space-8) var(--space-6); }
  .hushly-twosides__icon {
    width: var(--space-12, 48px);
    height: var(--space-12, 48px);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--sc-chip, var(--lavender-mist));
    color: var(--sc-accent, var(--accent));
  }
  .hushly-twosides__title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); color: var(--sc-text, var(--ink)); margin: 0; }
  .hushly-twosides__text { font-size: var(--fs-sm); line-height: var(--lh-body); color: var(--sc-muted, var(--muted)); margin: 0; }

  .hushly-twosides__usps {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    margin-block-start: var(--space-1);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--sc-border, var(--line));
    padding-inline: 0;
    list-style: none;
  }
  .hushly-twosides__usps li { display: flex; align-items: center; gap: var(--space-3); font-size: var(--fs-sm); font-weight: 500; color: var(--sc-text, var(--ink)); }
  .hushly-twosides__usp-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-8, 32px);
    height: var(--space-8, 32px);
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--sc-chip, var(--lavender-mist));
    color: var(--sc-accent, var(--accent));
  }
  .hushly-twosides__usp-icon svg { width: 16px; height: 16px; }

  @media (min-width: 768px) {
    .hushly-twosides__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-8); }
    .hushly-twosides__body { padding: var(--space-8); }
  }
</style>

{% schema %}
{
  "name": "Hushly Two Sides",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "mist", "label": "Mist" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "lilac", "label": "Lilac" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "cloud"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Én pude. To sider."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vælg den side, der passer til natten"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Text",
      "default": "Vend puden, som du har lyst til. Den ene side er kølende is-silke til varme nætter, den anden er blød, åndbar bambus til de køligere."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Side Card",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Main Icon (Snippet Name)",
          "default": "snow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Den kølende side"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Den køligste is-silke leder varmen væk, så siden bliver ved med at føles sval natten igennem."
        },
        {
          "type": "header",
          "content": "USP 1"
        },
        {
          "type": "text",
          "id": "usp_1_icon",
          "label": "USP 1 Icon",
          "default": "snow"
        },
        {
          "type": "text",
          "id": "usp_1_text",
          "label": "USP 1 Text",
          "default": "Kølende is-silke-overflade"
        },
        {
          "type": "header",
          "content": "USP 2"
        },
        {
          "type": "text",
          "id": "usp_2_icon",
          "label": "USP 2 Icon",
          "default": "check"
        },
        {
          "type": "text",
          "id": "usp_2_text",
          "label": "USP 2 Text",
          "default": "Sval ved berøring hele natten"
        },
        {
          "type": "header",
          "content": "USP 3 (Optional)"
        },
        {
          "type": "text",
          "id": "usp_3_icon",
          "label": "USP 3 Icon",
          "default": "check"
        },
        {
          "type": "text",
          "id": "usp_3_text",
          "label": "USP 3 Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hushly Two Sides",
      "blocks": [
        {
          "type": "card",
          "settings": { "icon": "snow", "title": "Den kølende side", "text": "Den køligste is-silke leder varmen væk...", "usp_1_icon": "snow", "usp_1_text": "Kølende is-silke-overflade", "usp_2_icon": "check", "usp_2_text": "Sval ved berøring hele natten" }
        },
        {
          "type": "card",
          "settings": { "icon": "leaf", "title": "Den bløde bambus-side", "text": "En blød, åndbar bambus-strik...", "usp_1_icon": "leaf", "usp_1_text": "Blød bambus-strik", "usp_2_icon": "moon", "usp_2_text": "Åndbar og lun til køligere nætter" }
        }
      ]
    }
  ]
}
{% endschema %}
