<section class="hushly-callout scheme scheme--{{ section.settings.color_scheme }}">
  <div class="container hushly-callout__inner" data-reveal="">
    <blockquote class="hushly-callout__quote hushly-callout__quote--anim">
      <span class="visually-hidden">{{ section.settings.quote }}</span>
      
      {%- assign words = section.settings.quote | split: ' ' -%}
      {%- assign char_index = 0 -%}
      <span class="hushly-callout__chars" aria-hidden="true" style="--char-delay: 45ms">
        {%- for word in words -%}
          <span class="hushly-callout__word">
            {%- assign chars = word | split: '' -%}
            {%- for char in chars -%}
              <span class="hushly-callout__char" style="--ci:{{ char_index }}">{{ char }}</span>
              {%- assign char_index = char_index | plus: 1 -%}
            {%- endfor -%}
          </span>
        {%- endfor -%}
      </span>
    </blockquote>
    {%- if section.settings.citation != blank -%}
      <p class="hushly-callout__cite">{{ section.settings.citation }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .hushly-callout__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
    padding-block: var(--section-y);
    max-width: var(--maxw-hero);
    margin-inline: auto;
  }
  .hushly-callout__icon {
    width: var(--space-16, 64px);
    height: var(--space-16, 64px);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--sc-chip, var(--lavender-mist));
    color: var(--sc-accent, var(--accent));
  }
  .hushly-callout__quote {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    letter-spacing: -.01em;
    color: var(--sc-text, var(--ink));
    margin: 0;
  }
  .hushly-callout__cite { font-size: var(--fs-sm); letter-spacing: .04em; text-transform: uppercase; color: var(--sc-muted, var(--muted)); margin: 0; }
  .hushly-callout__cta { margin-block-start: var(--space-2); }

  /* Letter-by-letter reveal (progressive enhancement: only when JS is on) */
  .hushly-callout__quote--anim .hushly-callout__word { display: inline-block; margin-inline: 0.14em; }
  .js .hushly-callout__char {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.32em);
    transition: opacity .55s var(--ease), transform .55s var(--ease);
    transition-delay: calc(var(--ci) * var(--char-delay, 45ms));
  }
  .js .hushly-callout__inner.is-revealed .hushly-callout__char { opacity: 1; transform: none; }
  /* Fallback if no .js class on body */
  body:not(.js) .hushly-callout__char { opacity: 1; transform: none; transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .js .hushly-callout__char { transition: none; transition-delay: 0s; opacity: 1; transform: none; }
  }
</style>

{% schema %}
{
  "name": "Hushly Callout",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "mist", "label": "Mist" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "lilac", "label": "Lilac" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "lilac"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "Et roligt sind og en kølig pude. Det er sådan en god nats søvn begynder."
    },
    {
      "type": "text",
      "id": "citation",
      "label": "Citation",
      "default": "Hushly"
    }
  ],
  "presets": [
    {
      "name": "Hushly Callout"
    }
  ]
}
{% endschema %}
