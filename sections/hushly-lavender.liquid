<section class="hushly-lavender scheme scheme--{{ section.settings.color_scheme }} hushly-lavender--media-{{ section.settings.media_position }}">
  <div class="container container--wide hushly-lavender__inner">
    <div class="hushly-lavender__media" data-reveal="">
      <div class="hushly-lavender__frame">
        {%- if section.settings.video_url != blank -%}
          <video class="hushly-lavender__video" playsinline controls preload="none" 
                 {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 864 }}"{% endif %}>
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {%- elsif section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" 
               alt="{{ section.settings.heading | escape }}" 
               srcset="{{ section.settings.image | image_url: width: 340 }} 340w, {{ section.settings.image | image_url: width: 544 }} 544w, {{ section.settings.image | image_url: width: 864 }} 864w, {{ section.settings.image | image_url: width: 1200 }} 1200w" 
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" 
               loading="lazy" class="hushly-lavender__video" style="object-fit: cover;"
               sizes="(min-width: 1024px) 44vw, 100vw">
        {%- else -%}
          <div class="hushly-lavender__video hushly-lavender__placeholder"></div>
        {%- endif -%}
      </div>
    </div>

    <div class="hushly-lavender__content" data-reveal="" style="--reveal-delay: calc(var(--reveal-step) * 1.5)">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hushly-lavender__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hushly-lavender__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="hushly-lavender__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hushly-lavender__features" role="list">
          {%- for block in section.blocks -%}
            <li class="hushly-lavender__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                <span class="hushly-lavender__feature-icon">
                  {% render 'icon', icon: block.settings.icon %}
                </span>
              {%- endif -%}
              <span class="hushly-lavender__feature-body">
                <span class="hushly-lavender__feature-title">{{ block.settings.title }}</span>
                <span class="hushly-lavender__feature-text">{{ block.settings.text }}</span>
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="hushly-lavender__cta">
          <a class="btn btn--primary" href="{{ section.settings.button_link }}">
            <span>{{ section.settings.button_label }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .hushly-lavender__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--section-y);
    align-items: center;
  }
  .hushly-lavender__media { width: 100%; }
  .hushly-lavender__frame {
    aspect-ratio: 3 / 4;
    max-width: var(--maxw-media, 600px);
    margin-inline: auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--sc-soft, var(--lilac));
  }
  .hushly-lavender__video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hushly-lavender__placeholder { width:100%; height:100%; background: linear-gradient(135deg, var(--lilac), var(--accent-soft)); }

  .hushly-lavender__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }
  .hushly-lavender__eyebrow { color: var(--sc-accent, var(--accent)); margin: 0; }
  .hushly-lavender__heading { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); color: var(--sc-text, var(--ink)); margin: 0; }
  .hushly-lavender__intro { font-size: var(--fs-lead); line-height: var(--lh-body); max-width: var(--maxw-lead); color: var(--sc-muted, var(--muted)); margin: 0; }

  .hushly-lavender__features { display: flex; flex-direction: column; gap: var(--space-4); width: 100%; margin-block-start: var(--space-2); margin-block-end: 0; padding: 0; list-style: none; }
  .hushly-lavender__feature { display: flex; gap: var(--space-3); text-align: start; }
  .hushly-lavender__feature-icon {
    width: var(--space-12, 48px);
    height: var(--space-12, 48px);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--sc-chip, var(--lavender-mist));
    color: var(--sc-accent, var(--accent));
  }
  .hushly-lavender__feature-body { display: flex; flex-direction: column; gap: var(--nudge, 2px); }
  .hushly-lavender__feature-title { font-weight: 600; color: var(--sc-text, var(--ink)); }
  .hushly-lavender__feature-text { font-size: var(--fs-sm); color: var(--sc-muted, var(--muted)); }
  .hushly-lavender__cta { margin-block-start: var(--space-2); }

  @media (min-width: 1024px) {
    .hushly-lavender__inner { grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
    .hushly-lavender__content { align-items: flex-start; text-align: start; }
    .hushly-lavender--media-right .hushly-lavender__media { order: 2; }
  }
</style>

{% schema %}
{
  "name": "Hushly Lavender",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "mist", "label": "Mist" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "lilac", "label": "Lilac" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "surface"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Paste a link to an MP4 file. If left blank, it will show the image instead."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster Image / Fallback Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media Position (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Lavendel-ro"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Et strejf lavendel — så du lander før sengetid"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Text",
      "default": "Lavendel er kendt for at fremme ro og afslapning..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Køb puden"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Snippet Name)",
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Beroligende duft"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "En mild, naturlig lavendelduft..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hushly Lavender",
      "blocks": [
        {
          "type": "feature",
          "settings": { "icon": "heart", "title": "Beroligende duft", "text": "En mild, naturlig lavendelduft..." }
        },
        {
          "type": "feature",
          "settings": { "icon": "moon", "title": "Mere rolig nattesøvn", "text": "En roligere indsovning kan understøtte..." }
        },
        {
          "type": "feature",
          "settings": { "icon": "leaf", "title": "Naturlig & mild", "text": "En diskret duft, der forsvinder blidt..." }
        }
      ]
    }
  ]
}
{% endschema %}
