<section class="hushly-cooling scheme scheme--{{ section.settings.color_scheme }} hushly-cooling--media-{{ section.settings.image_position }}">
  <div class="container container--wide hushly-cooling__inner">
    <div class="hushly-cooling__media" data-reveal="">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" 
             alt="{{ section.settings.heading | escape }}" 
             srcset="{{ section.settings.image | image_url: width: 340 }} 340w, {{ section.settings.image | image_url: width: 544 }} 544w, {{ section.settings.image | image_url: width: 720 }} 720w, {{ section.settings.image | image_url: width: 1088 }} 1088w, {{ section.settings.image | image_url: width: 1200 }} 1200w" 
             width="{{ section.settings.image.width }}" 
             height="{{ section.settings.image.height }}" 
             loading="lazy" 
             class="hushly-cooling__img" 
             sizes="(min-width: 1580px) 720px, (min-width: 1024px) 44vw, (min-width: 620px) 544px, calc(100vw - 2rem)">
      {%- else -%}
        <div class="hushly-cooling__img hushly-cooling__placeholder"></div>
      {%- endif -%}
    </div>

    <div class="hushly-cooling__content" data-reveal="" style="--reveal-delay: calc(var(--reveal-step) * 1.5)">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hushly-cooling__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hushly-cooling__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <p class="hushly-cooling__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hushly-cooling__features" role="list">
          {%- for block in section.blocks -%}
            <li class="hushly-cooling__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                <span class="hushly-cooling__feature-icon">
                  {% render 'icon', icon: block.settings.icon %}
                </span>
              {%- endif -%}
              <div>
                <p class="hushly-cooling__feature-title">{{ block.settings.title }}</p>
                <p class="hushly-cooling__feature-text">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="hushly-cooling__cta">
          <a class="btn btn--primary" href="{{ section.settings.button_link }}">
            <span>{{ section.settings.button_label }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .hushly-cooling__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--section-y);
    align-items: center;
  }
  .hushly-cooling__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--sc-soft, var(--lilac));
    aspect-ratio: 1 / 1;
    max-width: var(--maxw-panel);
    width: 100%;
    margin-inline: auto;
  }
  .hushly-cooling__img { width: 100%; height: 100%; object-fit: cover; }
  .hushly-cooling__placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--lilac), var(--accent-soft)); }

  .hushly-cooling__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }
  .hushly-cooling__eyebrow { color: var(--sc-accent, var(--accent)); margin: 0; }
  .hushly-cooling__heading { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); color: var(--sc-text, var(--ink)); margin: 0; }
  .hushly-cooling__intro { font-size: var(--fs-lead); line-height: var(--lh-body); max-width: var(--maxw-lead); color: var(--sc-muted, var(--muted)); margin: 0; }

  .hushly-cooling__features { display: flex; flex-direction: column; gap: var(--space-4); width: 100%; margin-block-start: var(--space-2); margin-block-end: 0; padding: 0; list-style: none; }
  .hushly-cooling__feature {
    display: flex;
    gap: var(--space-3);
    text-align: start;
    padding: var(--space-4);
    background: var(--sc-soft, var(--surface));
    border: 1px solid var(--sc-border, var(--line));
    border-radius: var(--radius);
  }
  .hushly-cooling__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12, 48px);
    height: var(--space-12, 48px);
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--sc-chip, var(--lavender-mist));
    color: var(--sc-accent, var(--accent));
  }
  .hushly-cooling__feature-title { font-weight: 600; color: var(--sc-text, var(--ink)); margin: 0 0 4px 0; }
  .hushly-cooling__feature-text { font-size: var(--fs-sm); color: var(--sc-muted, var(--muted)); margin: 0; }
  .hushly-cooling__cta { margin-block-start: var(--space-2); }

  @media (min-width: 1024px) {
    .hushly-cooling__inner { grid-template-columns: 1fr 1fr; gap: var(--space-16); }
    .hushly-cooling__content { align-items: flex-start; text-align: start; }
    .hushly-cooling__media { max-width: none; }
    .hushly-cooling--media-right .hushly-cooling__media { order: 2; }
  }
</style>

{% schema %}
{
  "name": "Image with Features",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "mist", "label": "Mist" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "lilac", "label": "Lilac" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "mist"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Kølende teknologi"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sådan holder den dig kølig"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Text",
      "default": "Den glatte is-silke-overflade leder kropsvarme og fugt væk fra huden — så siden bliver ved med at føles sval natten igennem. Vend til den åndbare bambus-side, når du vil have det lunere."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Køb puden"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Snippet Name)",
          "default": "snow",
          "info": "e.g. 'snow', 'leaf', 'check', 'shield', 'moon'. Leave 'none' to hide."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Features",
      "blocks": [
        {
          "type": "feature",
          "settings": { "icon": "snow", "title": "Sval ved berøring", "text": "Is-silken føles køligere end huden — du mærker det med det samme." }
        },
        {
          "type": "feature",
          "settings": { "icon": "leaf", "title": "Fugttransporterende", "text": "Leder sved og fugt væk, så du sover tørt." }
        },
        {
          "type": "feature",
          "settings": { "icon": "check", "title": "Temperaturregulerende", "text": "En sval overflade hele natten — ingen varme zoner." }
        }
      ]
    }
  ]
}
{% endschema %}
