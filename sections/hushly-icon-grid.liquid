<section class="shopify-section">
  <div class="hushly-icongrid {{ section.settings.color_scheme }}">
    <div class="container {% if section.settings.columns == 4 %}container--wide{% endif %}">
      
      {%- if section.settings.heading != blank -%}
        <h2 class="hushly-icongrid__heading" style="text-align: {{ section.settings.heading_alignment }};">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <div class="hushly-icongrid__grid hushly-icongrid__grid--{{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          <div class="hushly-icongrid__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: section.settings.image_style }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg ' | append: section.settings.image_style }}
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <b class="hushly-icongrid__title">{{ block.settings.title | escape }}</b>
            {%- endif -%}
            
            {%- if block.settings.text != blank -%}
              <p class="hushly-icongrid__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<style>
  .hushly-icongrid { padding: 90px 0; background: var(--bg); color: var(--ink); }
  .hushly-icongrid.scheme--surface { background: var(--surface); }
  .hushly-icongrid.scheme--mist { background: var(--mist); }
  .hushly-icongrid.scheme--lilac { background: var(--lilac); }
  
  .hushly-icongrid__heading { font-family: var(--disp); font-weight: 600; font-size: 38px; letter-spacing: -.02em; margin-bottom: 50px; }
  
  .hushly-icongrid__grid { display: grid; gap: 40px; }
  .hushly-icongrid__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .hushly-icongrid__grid--4 { grid-template-columns: repeat(4, 1fr); gap: 30px; }
  
  .hushly-icongrid__item { text-align: center; }
  .hushly-icongrid__img { width: 140px; height: 140px; object-fit: cover; margin: 0 auto 20px; display: block; border-radius: 20px; }
  .hushly-icongrid__img--round { border-radius: 50%; border: 4px solid #fff; box-shadow: 0 10px 30px -10px rgba(38, 42, 86, 0.15); width: 160px; height: 160px; }
  
  .hushly-icongrid__item .placeholder-svg { width: 140px; height: 140px; margin: 0 auto 20px; background: #e0e0e0; border-radius: 20px; }
  .hushly-icongrid__item .placeholder-svg.hushly-icongrid__img--round { border-radius: 50%; width: 160px; height: 160px; }

  .hushly-icongrid__title { display: block; font-family: var(--disp); font-weight: 600; font-size: 19px; margin-bottom: 8px; color: var(--ink); }
  .hushly-icongrid__text { font-size: 15px; color: var(--muted); line-height: 1.5; margin: 0; }

  @media (max-width: 860px) {
    .hushly-icongrid { padding: 60px 0; }
    .hushly-icongrid__heading { font-size: 30px; margin-bottom: 40px; text-align: center !important; }
    .hushly-icongrid__grid { grid-template-columns: 1fr; gap: 40px; }
    .hushly-icongrid__grid--4 { grid-template-columns: 1fr 1fr; gap: 30px 20px; }
    .hushly-icongrid__grid--4 .hushly-icongrid__img { width: 100px; height: 100px; }
  }
</style>

{% schema %}
{
  "name": "Icon Grid",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "", "label": "Default Background" },
        { "value": "scheme--surface", "label": "Surface (White)" },
        { "value": "scheme--mist", "label": "Mist (Light Gray)" },
        { "value": "scheme--lilac", "label": "Lilac" }
      ],
      "default": "scheme--mist"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium materialer, premium søvn."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image Style",
      "options": [
        { "value": "hushly-icongrid__img", "label": "Rounded Square" },
        { "value": "hushly-icongrid__img hushly-icongrid__img--round", "label": "Circle" }
      ],
      "default": "hushly-icongrid__img"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Grid Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Material"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Description of the material or feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Grid",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
