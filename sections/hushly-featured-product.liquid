<section class="hushly-feat scheme scheme--{{ section.settings.color_scheme }}">
  <div class="container container--wide hushly-feat__inner">
    {%- assign product = section.settings.product -%}
    
    <div class="hushly-feat__media" data-reveal="">
      {%- assign img = section.settings.image | default: product.featured_image -%}
      {%- if img != blank -%}
        <img src="{{ img | image_url: width: 1200 }}" 
             alt="{{ img.alt | default: section.settings.heading | escape }}" 
             srcset="{{ img | image_url: width: 340 }} 340w, {{ img | image_url: width: 544 }} 544w, {{ img | image_url: width: 720 }} 720w, {{ img | image_url: width: 1088 }} 1088w, {{ img | image_url: width: 1200 }} 1200w" 
             width="{{ img.width }}" height="{{ img.height }}" 
             loading="lazy" class="hushly-feat__img" 
             sizes="(min-width: 1580px) 720px, (min-width: 1024px) 44vw, calc(100vw - 2rem)">
      {%- else -%}
        <div class="hushly-feat__placeholder"></div>
      {%- endif -%}
      
      {%- if section.settings.tag_text != blank -%}
        <div class="hushly-feat__tag">
          <span class="hushly-feat__tag-dot" aria-hidden="true"></span>
          <span>{{ section.settings.tag_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="hushly-feat__content" data-reveal="" style="--reveal-delay: calc(var(--reveal-step) * 1.5)">
      <div class="hushly-feat__head">
        <h2 class="hushly-feat__heading">{{ section.settings.heading | default: product.title | default: "Featured Product" }}</h2>
        
        {%- if section.blocks.size > 0 -%}
          <div class="hushly-feat__chips" role="list">
            {%- for block in section.blocks -%}
              <span class="hushly-feat__chip" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != 'none' -%}
                  {% render 'icon', icon: block.settings.icon %}
                {%- endif -%}
                <span>{{ block.settings.text }}</span>
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hushly-feat__price">
        <span class="visually-hidden">Pris</span>
        {%- if product != blank -%}
          <span class="hushly-feat__price-current">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="hushly-feat__price-compare">{{ product.compare_at_price | money }}</span>
            {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <span class="hushly-feat__badge">Spar {{ savings }}%</span>
          {%- endif -%}
        {%- else -%}
          <span class="hushly-feat__price-current">499 kr</span>
          <span class="hushly-feat__price-compare">799 kr</span>
          <span class="hushly-feat__badge">Spar 38%</span>
        {%- endif -%}
      </div>

      <div class="hushly-feat__actions">
        <a class="btn btn--primary btn--lg" href="{{ product.url | default: section.settings.button_link | default: '#' }}">
          <span>{{ section.settings.button_label }}</span>
        </a>
        
        {%- if section.settings.show_payments -%}
          <div class="hushly-feat__payments">
            <span class="hushly-feat__pay-label">{{ section.settings.payments_label }}</span>
            <div class="hushly-feat__pay-icons">
              {%- unless shop.enabled_payment_types == empty -%}
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                {%- endfor -%}
              {%- endunless -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .hushly-feat__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--section-y);
    align-items: center;
  }
  .hushly-feat__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--sc-soft, var(--lilac));
    aspect-ratio: 1 / 1;
    max-width: var(--maxw-panel);
    width: 100%;
    margin-inline: auto;
  }
  .hushly-feat__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hushly-feat__placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--lilac), var(--accent-soft)); }
  .hushly-feat__tag {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-start: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--surface, #fff);
    color: var(--ink, #111);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
  }
  .hushly-feat__tag-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse-dot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: .4; }
  }

  .hushly-feat__content { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); }
  .hushly-feat__head { display: flex; flex-direction: column; gap: var(--space-4); }
  .hushly-feat__heading { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); letter-spacing: -.02em; color: var(--sc-text, var(--ink)); margin: 0; }
  .hushly-feat__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  .hushly-feat__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    background: var(--sc-soft, var(--surface));
    border: 1px solid var(--sc-border, var(--line));
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--sc-text, var(--ink));
  }
  .hushly-feat__chip svg { width: 16px; height: 16px; color: var(--sc-accent, var(--accent)); }

  .hushly-feat__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); }
  .hushly-feat__price-current { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); color: var(--sc-text, var(--ink)); }
  .hushly-feat__price-compare { font-size: var(--fs-lead); text-decoration: line-through; color: var(--sc-muted, var(--muted)); }
  .hushly-feat__badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    vertical-align: middle;
    transform: translateY(-2px);
  }

  .hushly-feat__actions { display: flex; flex-direction: column; gap: var(--space-4); width: 100%; max-width: var(--maxw-lead); }
  .hushly-feat__payments { display: flex; flex-direction: column; gap: var(--space-2); align-items: flex-start; }
  .hushly-feat__pay-label { font-size: var(--fs-xs); color: var(--sc-muted, var(--muted)); }
  .hushly-feat__pay-icons { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .hushly-feat__pay-icons svg { height: auto; max-height: 24px; width: auto; min-width: 0; flex: 0 1 auto; border-radius: var(--radius-sm); box-shadow: var(--shadow-sm); }

  @media (min-width: 1024px) {
    .hushly-feat__inner { grid-template-columns: 1fr 1fr; gap: var(--space-16); }
    .hushly-feat__media { max-width: none; }
  }
</style>

{% schema %}
{
  "name": "Hushly Featured Product",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "mist", "label": "Mist" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "lilac", "label": "Lilac" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "surface"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Image",
      "info": "Overrides the product's featured image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Custom Heading",
      "info": "Overrides the product title"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Badge Text on Image",
      "default": "Mest populære"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Køb puden"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link (Fallback if no product)"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payments_label",
      "label": "Payments Label",
      "default": "Sikker betaling"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Feature Chip",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Snippet Name)",
          "default": "snow"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Kølende is-silke"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hushly Featured Product",
      "blocks": [
        { "type": "chip", "settings": { "icon": "snow", "text": "Kølende is-silke" } },
        { "type": "chip", "settings": { "icon": "leaf", "text": "Blød bambus" } },
        { "type": "chip", "settings": { "icon": "moon", "text": "Ergonomisk memory foam" } }
      ]
    }
  ]
}
{% endschema %}
