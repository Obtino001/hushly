<section class="shopify-section shopify-section-group-main-group">
  <div class="hvb {{ section.settings.color_scheme }}" data-hvb="">
    <div class="container container--wide">
      <div class="hvb__grid">
        <div class="hvb__vid">
          {%- if section.settings.video != blank -%}
            {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, image_size: '800x' }}
          {%- elsif section.settings.video_url != blank -%}
            <video autoplay loop muted playsinline>
              <source src="{{ section.settings.video_url }}" type="video/mp4">
            </video>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="hvb__txt">
          <h2 class="hvb__h">{{ section.settings.heading }}</h2>
          <p class="hvb__p">{{ section.settings.text }}</p>
          
          <div class="hvb__steps">
            {%- for block in section.blocks -%}
              <div class="hvb__step" {{ block.shopify_attributes }}>
                <i>{{ forloop.index }}</i>
                <span><b>{{ block.settings.title }}</b><br>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hvb { padding: 80px 0; background: var(--bg); color: var(--ink); }
  .hvb.scheme--surface { background: var(--surface); }
  .hvb__grid { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 70px; }
  .hvb__vid { border-radius: 20px; overflow: hidden; aspect-ratio: 4/4.5; background: #EAE3F6; position: relative; }
  .hvb__vid video, .hvb__vid svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hvb__txt { padding-right: 20px; }
  .hvb__h { font-family: var(--disp); font-weight: 600; font-size: 42px; margin-bottom: 16px; letter-spacing: -.02em; line-height: 1.1; }
  .hvb__p { font-size: 17px; color: var(--muted); margin-bottom: 34px; line-height: 1.5; max-width: 90%; }
  
  .hvb__steps { display: grid; gap: 26px; }
  .hvb__step { display: flex; align-items: flex-start; gap: 18px; }
  .hvb__step i { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: var(--mist); color: var(--iris); font-family: var(--disp); font-weight: 600; font-size: 16px; font-style: normal; border: 1px solid var(--lilac); }
  .hvb__step span { font-size: 15px; color: var(--muted); line-height: 1.45; }
  .hvb__step b { color: var(--ink); font-weight: 600; display: block; margin-bottom: 3px; font-size: 16px; font-family: var(--disp); }
  
  @media (max-width: 860px) {
    .hvb { padding: 50px 0; }
    .hvb__grid { grid-template-columns: 1fr; gap: 34px; }
    .hvb__txt { padding-right: 0; }
    .hvb__h { font-size: 34px; }
    .hvb__p { font-size: 16px; margin-bottom: 28px; }
    .hvb__vid { aspect-ratio: 1/1; border-radius: 16px; }
    .hvb__steps { gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Video Steps",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "", "label": "Default Background" },
        { "value": "scheme--surface", "label": "Surface (White)" }
      ],
      "default": ""
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Direct Video URL (MP4)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sådan virker den."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Din søvn er unik. Derfor har vi gjort det nemt at finde den støtte, der passer præcis til dig."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
