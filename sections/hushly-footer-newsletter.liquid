<div class="hushly-news scheme scheme--{{ section.settings.color_scheme }}">
  <div class="container hushly-news__inner">
    <div class="hushly-news__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hushly-news__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hushly-news__heading">{{ section.settings.heading }}<span class="hushly-news__dot">.</span></h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="hushly-news__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
    
    <div class="hushly-news__form-wrap">
      {% form 'customer', class: 'hushly-news__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="hushly-news__row">
          <label class="visually-hidden" for="NewsEmail-{{ section.id }}">Din e-mail</label>
          <input class="hushly-news__input" 
                 id="NewsEmail-{{ section.id }}" 
                 type="email" 
                 name="contact[email]" 
                 value="{{ form.email }}" 
                 placeholder="{{ section.settings.placeholder }}" 
                 aria-label="{{ section.settings.placeholder }}" 
                 autocomplete="email" 
                 autocorrect="off" 
                 autocapitalize="off" 
                 required>
          <button type="submit" class="btn btn--accent hushly-news__btn" name="commit">{{ section.settings.button_label }}</button>
        </div>
        
        {%- if form.posted_successfully? -%}
          <p class="hushly-news__ok" tabindex="-1" autofocus>
            {% render 'icon', icon: 'check' %} {{ section.settings.success_message }}
          </p>
        {%- elsif form.errors -%}
          <p class="hushly-news__err" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        {%- if section.settings.consent != blank -%}
          <p class="hushly-news__consent">{{ section.settings.consent }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

<style>
  .hushly-news { background: var(--sc-bg); color: var(--sc-text); }
  .hushly-news__inner { padding-block: var(--section-y); display: grid; gap: var(--space-6); }
  .hushly-news__eyebrow { color: var(--sc-accent, var(--accent)); }
  .hushly-news__heading { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); letter-spacing: -.02em; line-height: var(--lh-tight); color: var(--sc-text, var(--ink)); }
  .hushly-news__dot { color: var(--accent-soft); }
  .hushly-news__intro { font-size: var(--fs-md, 1rem); line-height: var(--lh-body); color: var(--sc-muted, var(--muted)); margin-block-start: var(--space-2); max-width: 34rem; }
  .hushly-news__form-wrap { display: flex; flex-direction: column; gap: var(--space-2); }
  .hushly-news__row { display: flex; flex-direction: column; gap: var(--space-3); }
  .hushly-news__input {
    flex: 1 1 auto; min-width: 0; min-height: var(--tap);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-sans); font-size: var(--fs-body);
    color: var(--ink); background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius-pill);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .hushly-news__input::placeholder { color: var(--muted); opacity: 1; }
  .hushly-news__input:focus-visible { outline: none; border-color: var(--accent); box-shadow: var(--focus-ring); }
  .hushly-news__btn { flex: none; }
  .hushly-news__consent { font-size: var(--fs-sm); color: var(--sc-muted, var(--muted)); margin: 0; }
  .hushly-news__ok { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 500; color: var(--sc-text, var(--ink)); margin-top: var(--space-3); }
  .hushly-news__ok svg { width: 16px; height: 16px; color: var(--sc-accent, var(--accent)); }
  .hushly-news__err { color: var(--danger); font-size: var(--fs-sm); margin-top: var(--space-3); }

  @media (min-width: 720px) {
    .hushly-news__inner { grid-template-columns: 1.1fr 1fr; align-items: center; gap: var(--space-12); }
    .hushly-news__row { flex-direction: row; align-items: stretch; }
  }
</style>

{% schema %}
{
  "name": "Hushly Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "mist", "label": "Mist" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "lilac", "label": "Lilac" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "lilac"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Sov blødere"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Få ro i indbakken"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Text",
      "default": "Blide tips til ro og afslapning, små historier fra Hushly og besked, når der sker noget nyt. Ikke for ofte."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Din e-mail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Tilmeld"
    },
    {
      "type": "text",
      "id": "consent",
      "label": "Consent Text",
      "default": "Afmeld når som helst. Vi deler aldrig din e-mail."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Tak for din tilmelding!"
    }
  ],
  "presets": [
    {
      "name": "Hushly Newsletter"
    }
  ]
}
{% endschema %}
