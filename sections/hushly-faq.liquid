<section class="shopify-section">
  <div class="hushly-faq {{ section.settings.color_scheme }}">
    <div class="container">
      
      <div class="hushly-faq__top">
        {%- if section.settings.heading != blank -%}
          <h2 class="hushly-faq__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="hushly-faq__sub">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
      
      <div class="hushly-faq__list">
        {%- for block in section.blocks -%}
          <details class="hushly-faq__item" {{ block.shopify_attributes }}>
            <summary class="hushly-faq__q">
              {{ block.settings.question | escape }}
              <span class="hushly-faq__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
            </summary>
            <div class="hushly-faq__a">
              <div class="hushly-faq__a-in rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </details>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<style>
  .hushly-faq { padding: 90px 0; background: var(--bg); color: var(--ink); }
  .hushly-faq.scheme--surface { background: var(--surface); }
  
  .hushly-faq__top { text-align: center; margin-bottom: 50px; }
  .hushly-faq__heading { font-family: var(--disp); font-weight: 600; font-size: 38px; letter-spacing: -.02em; margin-bottom: 12px; }
  .hushly-faq__sub { font-size: 17px; color: var(--muted); }
  
  .hushly-faq__list { max-width: 800px; margin: 0 auto; display: grid; gap: 14px; }
  
  .hushly-faq__item { border: 1px solid var(--line); border-radius: 16px; background: var(--surface); overflow: hidden; transition: .2s; }
  .hushly-faq__item[open] { border-color: var(--iris); box-shadow: 0 10px 30px -10px rgba(110, 95, 190, 0.15); }
  
  .hushly-faq__q { 
    display: flex; justify-content: space-between; align-items: center; gap: 16px; 
    padding: 22px 24px; font-family: var(--disp); font-weight: 600; font-size: 18px; 
    cursor: pointer; user-select: none; list-style: none; outline: none; 
  }
  .hushly-faq__q::-webkit-details-marker { display: none; }
  
  .hushly-faq__icon { 
    flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%; background: var(--mist); 
    display: flex; align-items: center; justify-content: center; color: var(--iris); transition: .3s; 
  }
  .hushly-faq__icon svg { width: 18px; height: 18px; transition: .3s; }
  .hushly-faq__item[open] .hushly-faq__icon { background: var(--iris); color: #fff; }
  .hushly-faq__item[open] .hushly-faq__icon svg { transform: rotate(180deg); }
  
  .hushly-faq__a { padding: 0 24px 24px; }
  .hushly-faq__a-in { font-size: 16px; color: var(--muted); line-height: 1.6; border-top: 1px solid var(--line); padding-top: 18px; }
  
  @media (max-width: 860px) {
    .hushly-faq { padding: 60px 0; }
    .hushly-faq__heading { font-size: 32px; }
    .hushly-faq__sub { font-size: 16px; }
    .hushly-faq__q { padding: 18px 20px; font-size: 16px; }
    .hushly-faq__a { padding: 0 20px 20px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Simple logic to close other FAQs when one opens
    const faqs = document.querySelectorAll('.hushly-faq__item');
    faqs.forEach(faq => {
      faq.addEventListener('toggle', (e) => {
        if(faq.open) {
          faqs.forEach(otherFaq => {
            if(otherFaq !== faq) otherFaq.removeAttribute('open');
          });
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "", "label": "Default Background" },
        { "value": "scheme--surface", "label": "Surface (White)" }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oftest stillede spørgsmål"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Få svar på det, de fleste undrer sig over."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Q&A",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Hvad er et spørgsmål?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Dette er et svar på spørgsmålet.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
