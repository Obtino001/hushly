<section class="hushly-hero" data-hero="">
  <div class="hushly-hero__card hushly-hero--{{ section.settings.text_color }} hushly-hero--{{ section.settings.hero_height }}" style="--ov-color: {{ section.settings.overlay_color }}; --ov-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-eyebrow-bg: {{ section.settings.eyebrow_bg }}; --hero-eyebrow-text: {{ section.settings.eyebrow_text }}; --hero-heading: {{ section.settings.heading_color }}; --hero-body: {{ section.settings.body_color }}; --hero-star: {{ section.settings.star_color }};">
    <div class="hushly-hero__bg">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 420 }} 420w, {{ section.settings.image_mobile | image_url: width: 680 }} 680w">
          {%- endif -%}
          <img src="{{ section.settings.image | image_url: width: 2000 }}" 
               alt="{{ section.settings.heading | escape }}" 
               srcset="{{ section.settings.image | image_url: width: 768 }} 768w, {{ section.settings.image | image_url: width: 1024 }} 1024w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w" 
               width="{{ section.settings.image.width }}" 
               height="{{ section.settings.image.height }}" 
               loading="eager" 
               fetchpriority="high" 
               class="hushly-hero__img" 
               sizes="(min-width: 1580px) 1500px, (min-width: 1000px) calc(100vw - 5rem), calc(100vw - 2rem)" 
               style="object-position: {{ section.settings.image.presentation.focal_point }};">
        </picture>
      {%- else -%}
        <div class="hushly-hero__img hushly-hero__img--placeholder"></div>
      {%- endif -%}
      <div class="hushly-hero__scrim"></div>
    </div>

    <div class="hushly-hero__inner">
      <div class="hushly-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow hushly-hero__eyebrow" data-hero-anim="">
            {%- if section.settings.eyebrow_icon != 'none' -%}
              {% render 'icon', icon: section.settings.eyebrow_icon %}
            {%- endif -%}
            <span>{{ section.settings.eyebrow }}</span>
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="hushly-hero__headline" data-hero-anim="">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="hushly-hero__body" data-hero-anim="">{{ section.settings.body }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="hushly-hero__actions" data-hero-anim="">
            <a class="btn btn--primary btn--lg" href="{{ section.settings.button_link }}">
              <span>{{ section.settings.button_label }}</span>
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.show_social_proof -%}
          <div class="hushly-hero__proof" data-hero-anim="">
            <div class="hushly-hero__avatars" aria-hidden="true">
              {%- for block in section.blocks -%}
                {%- if block.type == 'avatar' and block.settings.image != blank -%}
                  <span class="hushly-hero__avatar">
                    <img src="{{ block.settings.image | image_url: width: 96 }}" 
                         alt="" 
                         srcset="{{ block.settings.image | image_url: width: 48 }} 48w, {{ block.settings.image | image_url: width: 96 }} 96w" 
                         width="96" height="96" loading="lazy" class="hushly-hero__avatar-img" sizes="44px">
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if section.settings.trustpilot_link != blank -%}
              <a class="hushly-hero__tp" href="{{ section.settings.trustpilot_link }}" target="_blank" rel="noopener" aria-label="Se vores anmeldelser på Trustpilot">
                <span class="hushly-hero__tp-stars" aria-hidden="true">
                  <span class="hushly-hero__tp-star"><svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"></path></svg></span>
                  <span class="hushly-hero__tp-star"><svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"></path></svg></span>
                  <span class="hushly-hero__tp-star"><svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"></path></svg></span>
                  <span class="hushly-hero__tp-star"><svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"></path></svg></span>
                  <span class="hushly-hero__tp-star"><svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"></path></svg></span>
                </span>
                <span class="hushly-hero__tp-name">Trustpilot</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payments -%}
          <div class="hushly-hero__payments" data-hero-anim="">
            <span class="hushly-hero__payments-label">{{ section.settings.payments_label }}</span>
            <div class="hushly-hero__pay-icons">
              {%- unless shop.enabled_payment_types == empty -%}
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                {%- endfor -%}
              {%- endunless -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  /* Inset, rounded hero card — not full-bleed */
  .hushly-hero { padding: var(--space-4) var(--gutter); }

  .hushly-hero__card {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    overflow: hidden;
    max-width: var(--container-wide);
    margin-inline: auto;
    border-radius: var(--radius-lg);
    /* Mobile: compact but a touch taller than half-screen */
    min-height: var(--hero-h-mobile);
  }

  .hushly-hero__bg { position: absolute; inset: 0; z-index: 0; }
  .hushly-hero__bg picture { display: block; width: 100%; height: 100%; }
  .hushly-hero__img { width: 100%; height: 100%; object-fit: cover; }
  .hushly-hero__img--placeholder {
    background: linear-gradient(135deg, var(--lilac), var(--lavender-mist) 55%, var(--accent-soft));
  }
  .hushly-hero__scrim {
    position: absolute;
    inset: 0;
    background: var(--ov-color, var(--ink));
    opacity: var(--ov-opacity, .45);
  }

  .hushly-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding: var(--space-6) var(--gutter);
  }
  .hushly-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    max-width: var(--maxw-hero);
  }

  /* Display title — Outfit (shared brand display font) */
  /* Eyebrow rendered as a badge — readable on any image */
  .hushly-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    background: var(--hero-eyebrow-bg, var(--accent-soft));
    color: var(--hero-eyebrow-text, var(--ink));
    border-radius: var(--radius-pill);
    text-shadow: none;
    margin: 0;
  }
  .hushly-hero__eyebrow svg { width: 14px; height: 14px; }

  .hushly-hero__headline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    letter-spacing: -.02em;
    color: var(--hero-heading, var(--on-dark));
    margin: 0;
  }
  .hushly-hero__body {
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    max-width: var(--maxw-lead);
    color: var(--hero-body, var(--on-dark));
    margin: 0;
  }

  /* Light text over imagery (default) */
  .hushly-hero--light { color: var(--on-dark); }
  .hushly-hero--light .hushly-hero__content { text-shadow: none; }
  /* Legibility halo behind the centred content so the subtitle stays readable on busy images */
  .hushly-hero--light .hushly-hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(130% 95% at 50% 58%, color-mix(in srgb, var(--ink) 42%, transparent) 0%, transparent 62%);
    pointer-events: none;
  }
  .hushly-hero .rating__layer--fill .rating__star { fill: var(--hero-star, var(--accent-soft)); }
  .hushly-hero--light .rating__layer--base .rating__star { fill: color-mix(in srgb, var(--on-dark) 35%, transparent); }

  /* Dark text (for light imagery) */
  .hushly-hero--dark { color: var(--ink); }

  .hushly-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin-block-start: var(--space-2);
  }

  /* Social proof */
  .hushly-hero__proof {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }
  .hushly-hero__avatars { display: flex; }
  .hushly-hero__avatar {
    width: var(--avatar-size, 44px);
    height: var(--avatar-size, 44px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--lavender-mist);
    color: var(--accent);
    border: var(--ring, 2px) solid var(--surface, #fff);
    overflow: hidden;
    margin-inline-start: calc(var(--space-2, 8px) * -1);
  }
  .hushly-hero__avatar:first-child { margin-inline-start: 0; }
  .hushly-hero__avatar-img { width: 100%; height: 100%; object-fit: cover; }
  
  .hushly-hero__tp { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; }
  .hushly-hero__tp-stars { display: inline-flex; gap: 3px; }
  .hushly-hero__tp-star { width: 22px; height: 22px; background: #00B67A; border-radius: 3px; display: inline-flex; align-items: center; justify-content: center; }
  .hushly-hero__tp-star svg { width: 14px; height: 14px; }
  .hushly-hero__tp-name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-sm); color: var(--hero-body, var(--on-dark)); }
  .hushly-hero__tp:hover .hushly-hero__tp-name { text-decoration: underline; text-underline-offset: .2em; }

  /* Payments */
  .hushly-hero__payments {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }
  .hushly-hero__payments-label {
    font-size: var(--fs-xs);
    letter-spacing: .04em;
    text-transform: uppercase;
    opacity: .85;
  }
  .hushly-hero__pay-icons {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
    max-width: 100%;
  }
  .hushly-hero__pay-icons svg {
    height: auto;
    width: auto;
    max-height: var(--pay-icon-h, 24px);
    min-width: 0;
    flex: 0 1 auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  /* Tablet & up: restore generous height + spacing */
  @media (min-width: 768px) {
    .hushly-hero { padding-block: var(--space-8); }
    .hushly-hero__card.hushly-hero--tall { min-height: var(--hero-h-tall); }
    .hushly-hero__card.hushly-hero--medium { min-height: var(--hero-h-medium); }
    .hushly-hero__card.hushly-hero--short { min-height: var(--hero-h-short); }
    .hushly-hero__inner { padding-block: var(--space-24); }
    .hushly-hero__content { gap: var(--space-4); }
  }

  /* Smooth, staggered entrance — motion only */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hushly-hero[data-hero] [data-hero-anim] { opacity: 0; animation: hero-rise .7s var(--ease) forwards; }
    .hushly-hero__content > [data-hero-anim]:nth-child(1) { animation-delay: .05s; }
    .hushly-hero__content > [data-hero-anim]:nth-child(2) { animation-delay: .13s; }
    .hushly-hero__content > [data-hero-anim]:nth-child(3) { animation-delay: .21s; }
    .hushly-hero__content > [data-hero-anim]:nth-child(4) { animation-delay: .29s; }
    .hushly-hero__content > [data-hero-anim]:nth-child(5) { animation-delay: .37s; }
    .hushly-hero__content > [data-hero-anim]:nth-child(6) { animation-delay: .45s; }
  }
</style>

{% schema %}
{
  "name": "Hushly Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Height",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#262a56"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 25
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Kølende memory-foam pude"
    },
    {
      "type": "text",
      "id": "eyebrow_icon",
      "label": "Eyebrow Icon (Snippet Name)",
      "default": "snow",
      "info": "Name of the snippet for the icon (e.g. 'snow', 'leaf'). Leave as 'none' to hide."
    },
    {
      "type": "color",
      "id": "eyebrow_bg",
      "label": "Eyebrow Background",
      "default": "#a294d6"
    },
    {
      "type": "color",
      "id": "eyebrow_text",
      "label": "Eyebrow Text Color",
      "default": "#262a56"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sov køligt. Sov blødere."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Text",
      "default": "Kølende is-silke, en blød bambus-side, ergonomisk memory foam og et strejf beroligende lavendel — så du lander efter dagen og sover køligt og roligt."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Køb puden"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Social Proof & Payments"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Show Trustpilot & Avatars",
      "default": true
    },
    {
      "type": "url",
      "id": "trustpilot_link",
      "label": "Trustpilot Link",
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color (Optional)",
      "default": "#a294d6"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payments_label",
      "label": "Payments Label",
      "default": "Betal trygt med"
    }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Avatar Image",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hushly Hero",
      "blocks": [
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" }
      ]
    }
  ]
}
{% endschema %}
