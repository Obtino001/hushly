<section class="shopify-section">
  <div class="hushly-cooling {{ section.settings.color_scheme }}" data-cooling="">
    <div class="container container--wide">
      <div class="hushly-cooling__grid">
        
        <div class="hushly-cooling__img-wrap">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 840 | image_tag: loading: 'lazy', class: 'hushly-cooling__img' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'hushly-cooling__img placeholder-svg' }}
          {%- endif -%}
          
          {%- if section.settings.show_dots -%}
            <div class="hushly-cooling__dot" style="top: 28%; left: 45%;"></div>
            <div class="hushly-cooling__dot" style="top: 60%; left: 30%;"></div>
            <div class="hushly-cooling__dot" style="top: 45%; left: 70%;"></div>
          {%- endif -%}
        </div>
        
        <div class="hushly-cooling__text">
          <h2 class="hushly-cooling__heading">{{ section.settings.heading | newline_to_br }}</h2>
          
          <div class="hushly-cooling__features">
            {%- for block in section.blocks -%}
              <div class="hushly-cooling__feat" {{ block.shopify_attributes }}>
                <i>
                  {%- if block.settings.icon != 'none' -%}
                    {% render 'icon', icon: block.settings.icon %}
                  {%- else -%}
                    {{ block.settings.custom_svg }}
                  {%- endif -%}
                </i>
                <span><b>{{ block.settings.title }}</b>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .hushly-cooling { padding: 90px 0; background: var(--bg); color: var(--ink); }
  .hushly-cooling.scheme--surface { background: var(--surface); }
  .hushly-cooling__grid { display: grid; grid-template-columns: 1fr .85fr; align-items: center; gap: 80px; }
  
  .hushly-cooling__img-wrap { position: relative; border-radius: 24px; overflow: hidden; background: #EAF1FA; }
  .hushly-cooling__img { width: 100%; height: auto; display: block; object-fit: cover; aspect-ratio: 4/3.4; }
  .hushly-cooling__img.placeholder-svg { background: #EAF1FA; fill: #A3B5CA; padding: 40px; }
  
  .hushly-cooling__dot { 
    position: absolute; width: 16px; height: 16px; background: #0EA5E9; border-radius: 50%; 
    box-shadow: 0 0 0 6px rgba(14, 165, 233, 0.2); animation: hp-pulse 2s infinite; 
  }
  @keyframes hp-pulse {
    0% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.4); }
    70% { box-shadow: 0 0 0 12px rgba(14, 165, 233, 0); }
    100% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0); }
  }

  .hushly-cooling__heading { font-family: var(--disp); font-weight: 600; font-size: 44px; line-height: 1.05; letter-spacing: -.02em; margin-bottom: 40px; }
  
  .hushly-cooling__features { display: grid; gap: 32px; }
  .hushly-cooling__feat { display: flex; gap: 20px; align-items: flex-start; }
  .hushly-cooling__feat i { 
    flex: 0 0 auto; width: 44px; height: 44px; background: #F0F6FC; color: #2C65A4; border-radius: 12px; 
    display: flex; align-items: center; justify-content: center; 
  }
  .hushly-cooling__feat i svg { width: 22px; height: 22px; }
  .hushly-cooling__feat span { font-size: 15px; color: var(--muted); line-height: 1.5; }
  .hushly-cooling__feat b { display: block; color: var(--ink); font-weight: 600; font-size: 17px; font-family: var(--disp); margin-bottom: 4px; }

  @media (max-width: 860px) {
    .hushly-cooling { padding: 60px 0; }
    .hushly-cooling__grid { grid-template-columns: 1fr; gap: 40px; }
    .hushly-cooling__heading { font-size: 34px; margin-bottom: 30px; }
    .hushly-cooling__features { gap: 26px; }
    .hushly-cooling__feat { gap: 16px; }
    .hushly-cooling__feat i { width: 38px; height: 38px; border-radius: 10px; }
    .hushly-cooling__feat i svg { width: 18px; height: 18px; }
  }
</style>

{% schema %}
{
  "name": "PDP Cooling Tech",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "", "label": "Default Background" },
        { "value": "scheme--surface", "label": "Surface (White)" }
      ],
      "default": "scheme--surface"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pulsing dots over image",
      "default": true
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Kølende teknologi.\nVirkelig."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None / Custom SVG" },
            { "value": "snow", "label": "Snowflake" },
            { "value": "moon", "label": "Moon" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Checkmark" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "snow"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG (if Icon is None)",
          "info": "Paste raw SVG code here"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Cooling Tech",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
