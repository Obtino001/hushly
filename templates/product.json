          "settings": {
            "question": "Hvordan tilpasser jeg puden til min sovestilling?",
            "answer": "<p>Det er helt simpelt. Du lyner betrækket og det inderste lag op, og fjerner fyld, indtil puden har den perfekte højde.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Hvor lang tid dufter puden af lavendel?",
            "answer": "<p>Lavendelduften er infuseret direkte i memory-skummet. Det aftager stille og roligt over et par år.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Kan betrækket vaskes?",
            "answer": "<p>Ja. Det yderste betræk kan lynes af og vaskes ved 40 grader i vaskemaskinen.</p>"
