    "pdp_how": {
      "type": "hushly-video-steps",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Åbn puden",
            "text": "Brug lynlåsen på siden til at åbne puden og få adgang til det indvendige fyld."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Fjern eller tilføj fyld",
            "text": "Tag håndfulde af det lavendel-infuserede memory-foam ud for en lavere profil."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Gem fyldet i posen",
            "text": "Opbevar ekstra fyld i den medfølgende pose til senere justering."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Luk og sov",
            "text": "Lyn puden igen og mærk med det samme, at den passer perfekt til dig."
          }
        }
      },
      "block_order": [
